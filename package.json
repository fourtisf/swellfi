{
  "name": "swellfi",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @swellfi/web --filter @swellfi/api dev",
    "dev:web": "pnpm --filter @swellfi/web dev",
    "dev:api": "pnpm --filter @swellfi/api dev",
    "build": "pnpm db:generate && pnpm --filter @swellfi/api build && pnpm --filter @swellfi/web build",
    "start": "pnpm --parallel --filter @swellfi/web --filter @swellfi/api start",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm --filter @swellfi/web lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @swellfi/db generate",
    "db:migrate": "pnpm --filter @swellfi/db migrate:dev",
    "db:deploy": "pnpm --filter @swellfi/db migrate:deploy",
    "db:seed": "pnpm --filter @swellfi/db seed",
    "db:studio": "pnpm --filter @swellfi/db studio",
    "mock:hl": "pnpm --filter @swellfi/web mock:hl"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
