# Copy to .env at the repo root. Both apps read this one file.

# ---------- Brand ----------
NEXT_PUBLIC_BRAND_NAME=Swellfi
APP_URL=http://localhost:3000

# ---------- Auth (Privy) ----------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Wallet sign-in sessions (MetaMask, Rabby, any browser wallet) are HMAC-signed with this.
# Required in production: at least 32 random characters (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Privy is optional: without it, login is browser-wallet only (no email / embedded wallets).
# Optional: Privy's JWT verification key (PEM, from the dashboard). When set the API
# verifies access tokens locally instead of fetching the key from Privy.
PRIVY_VERIFICATION_KEY=

# ---------- Hyperliquid ----------
# testnet | mainnet. Trading stays on testnet until ALFA explicitly approves mainnet.
NEXT_PUBLIC_HL_NETWORK=testnet
# Network used for market data (prices, book, candles). Defaults to NEXT_PUBLIC_HL_NETWORK.
NEXT_PUBLIC_HL_DATA_NETWORK=
# Comma-separated HIP-3 perp dexes to list next to the main dex (stocks, commodities).
NEXT_PUBLIC_HL_HIP3_DEXES=xyz
# Optional URL overrides (local mock server, self-hosted node). Leave blank for the official API.
NEXT_PUBLIC_HL_INFO_URL=
NEXT_PUBLIC_HL_WS_URL=
NEXT_PUBLIC_BUILDER_ADDRESS=
# Builder fee in tenths of a basis point: 50 = 5 bps = 0.05% (perps max 100)
NEXT_PUBLIC_BUILDER_FEE_TENTHS_BPS=50
# Arbitrum RPC for deposits (balance reads, receipts). Defaults to the public RPC of the
# network's chain (Arbitrum One / Arbitrum Sepolia). Use a paid RPC in production.
NEXT_PUBLIC_ARB_RPC_URL=
# Mainnet only: deposits from other networks/tokens (Ethereum, Base, Optimism, BNB Chain, Polygon,
# Avalanche; USDC, USDT, native coins) are routed into the Hyperliquid account by Relay
# (relay.link). Optional per-chain RPC overrides for balance reads, as JSON by chain id, e.g.
# {"1":"https://…","8453":"https://…"}. Defaults to public RPCs with a publicnode.com fallback.
NEXT_PUBLIC_RPC_URLS=
# Optional Relay API base URL. Defaults to https://api.relay.link.
NEXT_PUBLIC_RELAY_API_URL=
# WalletConnect (mobile wallets via QR). Free project id from https://cloud.reown.com; add your
# domain to the project's allowlist there. If empty, the WalletConnect button says it isn't set up yet.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------- API ----------
# Indexer (PM2 app "swellfi-indexer"): pulls every user's Hyperliquid fills into the activity feed,
# rankings and profile stats. Max Hyperliquid info requests per minute (Hyperliquid allows about
# 1200 weight/min per IP and most info requests weigh 20). INDEXER_DEBUG=1 logs every poll.
INDEXER_RPM=40
# Optional: Hyperliquid /info URL for the indexer (defaults to the trading network's public API).
INDEXER_INFO_URL=
# Optional: Market news sources, "Name|https://feed,Name|https://feed" (default: CoinDesk, Decrypt, Cointelegraph).
NEWS_FEEDS=

API_PORT=4000
API_HOST=127.0.0.1
# Where the Next.js dev server proxies /api/* (production: Nginx does this).
API_INTERNAL_URL=http://127.0.0.1:4000
DATABASE_URL=postgresql://swellfi:swellfi@localhost:5432/swellfi?schema=public
REDIS_URL=redis://localhost:6379
INVITE_ONLY=true
# Private preview: when set, every page asks for this code first (/access). Leave empty for a
# public site. Changing it signs everyone out of the gate. Uses SESSION_SECRET to sign the cookie.
SITE_ACCESS_CODE=
# Comma-separated master-wallet addresses with admin rights (approve waitlist, delete chat).
ADMIN_ADDRESSES=

# ---------- X (Phase 3) ----------
X_CLIENT_ID=
X_CLIENT_SECRET=

# ---------- Seed ----------
# Seeds demo traders, posts, activity, chat and funds so every screen has content in dev.
# Never enable this against the production database.
SEED_DEMO=true
# Invite codes created by the seed (comma-separated).
SEED_INVITE_CODES=SWELL-ALPHA,SWELL-BETA
